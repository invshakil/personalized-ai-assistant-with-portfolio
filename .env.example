# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git

DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/sshakil_db"
AUTH_SECRET="run: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Single admin user — seeded on first run / used to log in
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

ANTHROPIC_API_KEY="sk-ant-..."
# Bootstraps the Claude provider on first run; thereafter keys are managed in
# Settings → AI and stored encrypted in the database.

# Encrypts AI provider API keys at rest (AES-256-GCM). 32 bytes, base64.
# Generate with: openssl rand -base64 32
AI_CONFIG_SECRET="run: openssl rand -base64 32"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CV_URL=""

# ── Database backups (Settings → Backups) ──
# Directory where pg_dump files are written (defaults to ./backups).
BACKUP_DIR=""
# Folder containing the pg_dump / pg_restore binaries, if not on PATH.
# macOS (Homebrew libpq): /opt/homebrew/opt/libpq/bin
# Ubuntu (apt postgresql-client): usually on PATH, leave blank.
PG_BIN_DIR=""
# Google OAuth — shared by two features:
#   1. Drive backups (Settings → Backups): enable the Drive API, register redirect
#        <AUTH_URL>/api/admin/backup/google/callback
#   2. Booking / consultation scheduler (Settings → Booking): also enable the Google
#      Calendar API and register redirect
#        <AUTH_URL>/api/admin/booking/google/callback
# Create one OAuth 2.0 "Web application" client with BOTH redirect URIs and BOTH APIs
# enabled. Leave blank to use local backups only and disable online booking.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# ── Booking anti-abuse: Cloudflare Turnstile (Settings → Booking) ──
# Protects the PUBLIC booking form from bots. Get keys from the Cloudflare
# dashboard → Turnstile. If left blank, the captcha check is skipped (the honeypot
# + per-IP rate limit still apply). TURNSTILE_SECRET is accepted as a fallback name.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── SolisCloud solar monitoring (Settings → Solar) ──
# API credentials issued by Solis support (Basic Settings → API Management).
# SOLIS_KEY_SECRET is sensitive — keep it only in .env.local, never commit it.
SOLIS_KEY_ID=""
SOLIS_KEY_SECRET=""
# Base API URL Solis gave you (usually https://www.soliscloud.com:13333).
SOLIS_API_URL="https://www.soliscloud.com:13333"

# Bump this value to force all active sessions to re-authenticate
APP_VERSION="1.0"
