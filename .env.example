# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git

DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/sshakil_db"
AUTH_SECRET="run: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Single admin user — seeded on first run / used to log in
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

ANTHROPIC_API_KEY="sk-ant-..."
# Bootstraps the Claude provider on first run; thereafter keys are managed in
# Settings → AI and stored encrypted in the database.

# Encrypts AI provider API keys at rest (AES-256-GCM). 32 bytes, base64.
# Generate with: openssl rand -base64 32
AI_CONFIG_SECRET="run: openssl rand -base64 32"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CV_URL=""

# ── Database backups (Settings → Backups) ──
# Directory where pg_dump files are written (defaults to ./backups).
BACKUP_DIR=""
# Folder containing the pg_dump / pg_restore binaries, if not on PATH.
# macOS (Homebrew libpq): /opt/homebrew/opt/libpq/bin
# Ubuntu (apt postgresql-client): usually on PATH, leave blank.
PG_BIN_DIR=""
# Google Drive OAuth (offsite backup copy). Create an OAuth 2.0 "Web application"
# client in Google Cloud with the Drive API enabled, and register the redirect URI:
#   <AUTH_URL>/api/admin/backup/google/callback
# Leave blank to use local backups + download only (no Drive upload).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Bump this value to force all active sessions to re-authenticate
APP_VERSION="1.0"
