// Prisma schema for sshakil.com
// Stack: PostgreSQL, NextAuth v5, App Router

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth) ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // bcrypt hash — null for future OAuth users
  role          Role      @default(ADMIN)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  VIEWER
}

// ─── Portfolio Settings (admin-editable) ─────────────────────────────────────

model SiteSettings {
  id               String   @id @default("singleton")
  availableForWork Boolean  @default(true)
  heroTagline      String   @default("Tech Lead & Full-Stack Engineer")
  heroBio          String   @db.Text
  metaDescription  String   @db.Text
  metaKeywords     String   @db.Text
  cvUrl            String   @default("https://drive.google.com/file/d/15jSzTm3iaj_ghVqgC_t1Wk9bKnsIfGIA/view?usp=sharing")
  updatedAt        DateTime @updatedAt
}

// Business identity printed on Financial Tracker PDFs (receipts, statements,
// reports). Admin-editable singleton; falls back to defaults if unset.
model BusinessProfile {
  id        String   @id @default("singleton")
  name      String   @default("Syful Islam Shakil")
  tagline   String   @default("Software Engineering & Consulting")
  address   String   @default("")
  phone     String   @default("")
  email     String   @default("")
  updatedAt DateTime @updatedAt
}

// Database backup configuration (singleton) + the encrypted Google Drive
// OAuth refresh token (offsite upload). pg_dump runs on a schedule driven by
// `frequency`; the refresh token is AES-256-GCM encrypted at rest.
model BackupSettings {
  id             String    @id @default("singleton")
  frequency      String    @default("off") // "off" | "daily" | "weekly"
  retentionCount Int       @default(7)
  lastRunAt      DateTime?
  lastStatus     String? // "ok" | "error"
  lastError      String?   @db.Text
  driveConnected Boolean   @default(false)
  driveEmail     String?
  driveFolderId  String?
  driveTokenEnc  String?   @db.Text
  driveTokenIv   String?
  driveTokenTag  String?
  updatedAt      DateTime  @updatedAt
}

// One row per backup attempt — drives the list, retention pruning, and download.
model BackupRecord {
  id          String   @id @default(cuid())
  filename    String
  sizeBytes   Int      @default(0)
  location    String   @default("local") // "local" | "local+drive" | "drive"
  driveFileId String?
  trigger     String   @default("manual") // "manual" | "scheduled"
  status      String   @default("ok") // "ok" | "error"
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// AI provider configuration — admin-editable. Each row is one provider
// (e.g. "anthropic"). Exactly one row is active at a time (enforced in the
// service layer). API keys are AES-256-GCM encrypted at rest — the ciphertext,
// iv, and auth tag are stored separately; the plaintext key is never persisted.
model AiProviderConfig {
  id           String   @id @default(cuid())
  provider     String   @unique // "anthropic" | "openai" | "google"
  label        String
  apiKeyEnc    String?  @db.Text // ciphertext (null until a key is set)
  apiKeyIv     String?
  apiKeyTag    String?
  baseUrl      String? // optional endpoint override (proxies/self-host)
  defaultModel String
  isActive     Boolean  @default(false)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// AI assistant conversation history. A ChatSession holds the ordered
// ChatMessage turns (user + assistant final text only — tool round-trips are
// not persisted). Titles auto-generate from the first user message.
model ChatSession {
  id        String        @id @default(cuid())
  title     String        @default("New chat")
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([updatedAt])
}

model ChatMessage {
  id          String      @id @default(cuid())
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  role        ChatRole
  content     String      @db.Text
  // Attachments uploaded by the user with this turn (receipts, screenshots).
  // Json array of { url, mimeType }. Null/absent when the turn was text-only.
  attachments Json?
  createdAt   DateTime    @default(now())

  @@index([sessionId])
}

enum ChatRole {
  USER
  ASSISTANT
}

// One row per AI chat turn — token usage and computed USD cost. Powers the
// dashboard spend panel and monthly budget enforcement. Cost is in USD (the
// unit Anthropic bills in), kept separate from the BDT business ledgers.
model AiUsage {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  provider          String
  model             String
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  cacheReadTokens   Int      @default(0)
  cacheCreateTokens Int      @default(0)
  costUsd           Decimal  @db.Decimal(12, 6)

  @@index([createdAt])
}

// Monthly AI spend cap (singleton). When `enforce` is on and the current
// month's spend reaches `monthlyLimitUsd`, the chat route blocks new turns.
model AiBudget {
  id              String   @id @default("singleton")
  monthlyLimitUsd Decimal? @db.Decimal(10, 2) // null = no limit
  enforce         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// Admin dashboard appearance preferences. Drives the MUI theme via
// createAdminTheme(); admin-editable singleton, falls back to defaults if unset.
model AdminThemeSettings {
  id           String   @id @default("singleton")
  mode         String   @default("dark") // "light" | "dark" | "system"
  primaryColor String   @default("#7367f0")
  cardShadow   String   @default("soft") // "none" | "soft" | "elevated"
  cardBorder   Boolean  @default(true)
  borderRadius Int      @default(8)
  density      String   @default("comfortable") // "compact" | "comfortable"
  fontSize     Int      @default(14)
  updatedAt    DateTime @updatedAt
}

// ─── Property Settings (singleton) ───────────────────────────────────────────

model PropertySettings {
  id           String   @id @default("singleton")
  propertyName String   @default("Shakil Property")
  ownerName    String   @default("Md. Syful Islam Shakil")
  ownerPhone   String   @default("")
  address      String   @default("Dhaka, Bangladesh")
  bankAccount  String?
  updatedAt    DateTime @updatedAt
}

// ─── Property Management ──────────────────────────────────────────────────────

model Unit {
  id          String    @id @default(cuid())
  unitNumber  String    @unique // e.g. "Flat 1A", "Flat 2B"
  floor       String // e.g. "Ground Floor", "1st Floor"
  monthlyRent Decimal   @db.Decimal(10, 2)
  description String?
  isOccupied  Boolean   @default(false)
  notes       String?
  tenants     Tenant[]
  payments    Payment[]
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum TenantStatus {
  CURRENT
  FUTURE
  PAST
}

model Tenant {
  id             String           @id @default(cuid())
  tenantCode     String?          @unique // e.g. "T01", "T02"
  name           String
  phone          String?
  email          String?
  nidNumber      String?
  isExternal     Boolean          @default(false) // true = parking-only / non-resident member
  moveInDate     DateTime
  moveOutDate    DateTime?
  leaseEndDate   DateTime?
  isActive       Boolean          @default(true)
  tenantStatus   TenantStatus     @default(CURRENT) // CURRENT | FUTURE | PAST
  advancePaid    Boolean          @default(false)
  advanceAmount  Decimal?         @db.Decimal(10, 2) // BDT held; decreases as advance is applied
  advanceSettled Boolean          @default(false)
  notes          String?
  unit           Unit?            @relation(fields: [unitId], references: [id])
  unitId         String? // no @unique — multiple tenants (current + future) share a unit
  payments       Payment[]
  services       TenantService[]
  rentChanges    RentChange[]
  oneOffCharges  OneOffCharge[]
  vouchers       Voucher[]
  documents      TenantDocument[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Payment {
  id             String               @id @default(cuid())
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  tenantId       String
  unit           Unit?                @relation(fields: [unitId], references: [id])
  unitId         String? // null for external members
  rentDue        Decimal              @db.Decimal(10, 2) // expected total (rent + services + carry-forward)
  amountPaid     Decimal              @default(0) @db.Decimal(10, 2) // cash/bank received
  advanceApplied Decimal              @default(0) @db.Decimal(10, 2) // drawn from tenant advance
  carryForward   Decimal              @default(0) @db.Decimal(10, 2) // unpaid balance carried from previous month
  month          Int // 1–12
  year           Int
  paidDate       DateTime? // date of most recent payment transaction
  status         PaymentStatus        @default(PENDING)
  receiptNumber  String?              @unique // e.g. "RCP-2026-0001"
  notes          String?
  transactions   PaymentTransaction[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([tenantId, month, year])
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

model PaymentTransaction {
  id        String          @id @default(cuid())
  payment   Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String
  type      TransactionType
  amount    Decimal         @db.Decimal(10, 2)
  date      DateTime
  notes     String?
  createdAt DateTime        @default(now())
}

enum TransactionType {
  CASH
  BANK_TRANSFER
  ADVANCE_APPLIED
  ADJUSTMENT
  OTHER
}

model AddOnService {
  id          String          @id @default(cuid())
  name        String          @unique // e.g. "WiFi", "Parking", "Generator"
  description String?
  isActive    Boolean         @default(true)
  tenants     TenantService[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TenantService {
  id         String       @id @default(cuid())
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  tenantId   String
  service    AddOnService @relation(fields: [serviceId], references: [id])
  serviceId  String
  monthlyFee Decimal      @db.Decimal(10, 2) // per-tenant rate (variable)
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean      @default(true)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([tenantId, serviceId])
}

// A one-time, ad-hoc charge billed to a tenant for a specific month/year
// (e.g. a maintenance fee, a repair cost). Unlike TenantService fees these do
// NOT recur — each charge applies to exactly one billing period. Payment
// generation adds the month's charges into that period's rentDue, and the
// charge service keeps an already-generated bill in step when a charge is
// added/edited/removed. Linked to a Payment only by (tenantId, month, year).
model OneOffCharge {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  label     String // e.g. "Maintenance fee", "Plumbing repair"
  amount    Decimal  @db.Decimal(10, 2)
  month     Int // 1–12 — the billing month this charge applies to
  year      Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, month, year])
}

// A credit applied to one month's bill — a discount, or a reimbursement for
// something the tenant paid that the landlord owes (e.g. maintenance). Stored as
// a POSITIVE amount and SUBTRACTED from rentDue, mirroring OneOffCharge which is
// added. See src/services/property/vouchers.ts.
model Voucher {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  label     String // e.g. "Maintenance paid by tenant"
  amount    Decimal  @db.Decimal(10, 2) // positive; reduces the month's bill
  month     Int // 1–12 — the billing month this credit applies to
  year      Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, month, year])
}

model RentChange {
  id            String    @id @default(cuid())
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  tenantId      String
  effectiveDate DateTime
  previousRent  Decimal   @db.Decimal(10, 2)
  newRent       Decimal   @db.Decimal(10, 2)
  reason        String?
  appliedAt     DateTime? // null = pending; set when payment generation picks it up
  createdAt     DateTime  @default(now())
}

// ─── Payee Profiles ───────────────────────────────────────────────────────────

model Payee {
  id        String          @id @default(cuid())
  name      String
  role      String // free text: "Caretaker", "Electrician", "Plumber"
  phone     String?
  email     String?
  address   String?
  nidNumber String?
  notes     String?
  isActive  Boolean         @default(true)
  expenses  Expense[]
  documents PayeeDocument[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model PayeeDocument {
  id         String   @id @default(cuid())
  payee      Payee    @relation(fields: [payeeId], references: [id], onDelete: Cascade)
  payeeId    String
  fileName   String
  storedName String
  mimeType   String
  size       Int
  label      String? // "NID Front", "NID Back", "Contract"
  uploadedAt DateTime @default(now())
}

// ─── Tenant Documents ─────────────────────────────────────────────────────────

model TenantDocument {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  fileName   String // original filename shown to user
  storedName String // unique name on disk (avoids collisions)
  mimeType   String
  size       Int // bytes
  label      String? // optional label e.g. "NID Front", "Contract"
  uploadedAt DateTime @default(now())
}

// ─── Property Service Types ───────────────────────────────────────────────────

model PropertyServiceType {
  id          String          @id @default(cuid())
  name        String          @unique // "Electricity", "Plumbing", "Caretaker Salary"
  category    ExpenseCategory // coarse group for reporting
  description String?
  isActive    Boolean         @default(true)
  expenses    Expense[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ─── Property Expenses ────────────────────────────────────────────────────────

model Expense {
  id            String               @id @default(cuid())
  description   String
  amount        Decimal              @db.Decimal(10, 2)
  currency      String               @default("BDT")
  category      ExpenseCategory
  month         Int
  year          Int
  expenseDate   DateTime?
  paidTo        String? // legacy free-text; use payeeId for new records
  paymentMode   String?
  unitId        String?
  unit          Unit?                @relation(fields: [unitId], references: [id])
  payeeId       String?
  payee         Payee?               @relation(fields: [payeeId], references: [id])
  serviceTypeId String?
  serviceType   PropertyServiceType? @relation(fields: [serviceTypeId], references: [id])
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

enum ExpenseCategory {
  MAINTENANCE
  UTILITY
  SALARY // employee
  SUBSCRIPTION
  CONSTRUCTION
  OTHER
}

// ─── Renovation Tracker ───────────────────────────────────────────────────────

model RenovationItem {
  id          String           @id @default(cuid())
  title       String
  category    String // e.g. "Materials", "Constructor", "Services"
  subCategory String?
  amount      Decimal          @db.Decimal(10, 2)
  vendor      String?
  date        DateTime?
  status      RenovationStatus @default(PLANNED)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum RenovationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Financial Tracker (business / agency) ──────────────────────────────────────
// Tracks the software business — client income, employee salaries, tool
// subscriptions, fiscal-year P&L. Distinct from property/rental finance above.
// Currency: BDT throughout. Fiscal year = July→June, stored as "YYYY-YYYY".

model Employee {
  id        String            @id @default(cuid())
  name      String            @unique
  phone     String?
  isActive  Boolean           @default(true)
  notes     String?
  payments  EmployeePayment[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

// A client / income source. Used both as the origin of an Earning and as the
// client(s) a salary payment is attributed to (many-to-many via EmployeePayment).
model IncomeSource {
  id             String            @id @default(cuid())
  name           String            @unique
  notes          String?
  earnings       Earning[]
  salaryPayments EmployeePayment[] @relation("PaymentClients")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model BizExpenseCategory {
  id            String         @id @default(cuid())
  name          String         @unique
  expenses      BizExpense[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// A recurring subscription. Each active month auto-generates one BizExpense
// charge (idempotent), so per-month history and reports come for free.
// endDate null = active/ongoing; set when stopped (last month still charged).
model Subscription {
  id            String                      @id @default(cuid())
  name          String
  categoryId    String
  category      BizExpenseCategory          @relation(fields: [categoryId], references: [id])
  monthlyAmount Decimal                     @db.Decimal(12, 2) // BDT — the STARTING rate (from startDate)
  startDate     DateTime // normalized to the 1st of the start month
  endDate       DateTime? // null = active; else last charged month (1st)
  notes         String?
  charges       BizExpense[]
  rateChanges   SubscriptionRateChange[]
  overrides     SubscriptionMonthOverride[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@index([endDate])
}

// Effective-dated price change for a subscription (a hike or drop). The base
// Subscription.monthlyAmount is the starting rate; each rate change sets a new
// rate effective from `effectiveMonth` (1st of month) onward, until the next
// change. Charge amounts are recomputed deterministically from base + changes.
model SubscriptionRateChange {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  effectiveMonth DateTime // normalized to the 1st of the month
  monthlyAmount  Decimal      @db.Decimal(12, 2) // BDT
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([subscriptionId, effectiveMonth])
  @@index([subscriptionId])
}

// Per-month final-amount override (discount, coupon, free month, partial). When
// present for a month, this is the exact charged amount for that month,
// regardless of the scheduled rate.
model SubscriptionMonthOverride {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  month          DateTime // normalized to the 1st of the month
  amount         Decimal      @db.Decimal(12, 2) // BDT
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([subscriptionId, month])
  @@index([subscriptionId])
}

model Earning {
  id              String         @id @default(cuid())
  date            DateTime
  sourceId        String
  source          IncomeSource   @relation(fields: [sourceId], references: [id])
  remittance      RemittanceType @default(NON_REM)
  amount          Decimal        @db.Decimal(12, 2) // BDT — canonical; all reports sum this. = round(originalAmount * fxRate, 2)
  // Multi-currency: amount stays BDT canonical; these capture the original.
  currency        String         @default("BDT") // original currency: BDT | USD | EUR
  originalAmount  Decimal?       @db.Decimal(14, 2) // amount in `currency`; null legacy rows fall back to `amount`
  fxRate          Decimal        @default(1) @db.Decimal(18, 6) // BDT per 1 unit of `currency` at transaction time
  // Realized-basis income: a foreign earning is "pending" (realizedAt NULL) and NOT counted in the BDT
  // P&L until converted; on conversion these capture the ACTUAL BDT received at the real rate, booked in
  // the conversion period. BDT earnings are realized-on-earn (realizedAt=date, realizedAmount=amount,
  // realizedRate=1) so reports treat them identically. Reports sum `realizedAmount` bucketed by realizedAt.
  realizedAt      DateTime? // conversion value-date; NULL = pending conversion
  realizedAmount  Decimal?       @db.Decimal(14, 2) // actual BDT booked on conversion (what reports sum)
  realizedRate    Decimal?       @db.Decimal(18, 6) // actual BDT per 1 unit at conversion
  transferEntryId String? // the foreign→BDT MoneyEntry that realized it (many earnings may share one)
  transfer        MoneyEntry?    @relation("EarningRealization", fields: [transferEntryId], references: [id], onDelete: SetNull)
  fiscalYear      String // "2023-2024"
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([fiscalYear])
  @@index([sourceId])
  @@index([realizedAt])
}

model EmployeePayment {
  id             String         @id @default(cuid())
  date           DateTime
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  type           PaymentKind    @default(SALARY)
  reference      String? // optional free-text note (e.g. "wedding bonus"); legacy funding client
  clients        IncomeSource[] @relation("PaymentClients") // client(s) this salary is attributed to
  amount         Decimal        @db.Decimal(12, 2) // BDT — canonical; reports sum this. = round(originalAmount * fxRate, 2)
  // Multi-currency: amount stays BDT canonical; these capture the original.
  currency       String         @default("BDT") // original currency: BDT | USD | EUR
  originalAmount Decimal?       @db.Decimal(14, 2) // amount in `currency`; null legacy rows fall back to `amount`
  fxRate         Decimal        @default(1) @db.Decimal(18, 6) // BDT per 1 unit of `currency` at transaction time
  fiscalYear     String
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([fiscalYear])
  @@index([employeeId])
}

model BizExpense {
  id             String             @id @default(cuid())
  date           DateTime
  name           String // tool / service
  categoryId     String
  category       BizExpenseCategory @relation(fields: [categoryId], references: [id])
  isRecurring    Boolean            @default(false)
  amount         Decimal            @db.Decimal(12, 2) // BDT
  fiscalYear     String
  notes          String?
  // Set when this row was auto-generated from a subscription. One charge per
  // (subscription, month) — the date is normalized to the 1st of the month.
  subscriptionId String?
  subscription   Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([subscriptionId, date])
  @@index([fiscalYear])
}

enum RemittanceType {
  REM
  NON_REM
}

enum PaymentKind {
  SALARY
  BONUS
  ADVANCE
  OTHER
}

// ─── Money Manager (personal finance) ───────────────────────────────────────
// Personal cash-flow ledger: household income/expenses, account balances,
// transfers, and people you pay (recurring allowances + loans with balances).
// Currency: BDT. Distinct from the property and business domains above — venture
// take-home is shown read-only for context, never copied here (no double-count).
// Account balances and the savings number are derived purely from MoneyEntry.

enum MoneyEntryDirection {
  CREDIT // money in
  DEBIT // money out
  TRANSFER // account-to-account; excluded from income/expense/savings
}

enum MoneyAccountType {
  CASH
  BANK
  MOBILE_WALLET
  CREDIT_CARD
  OTHER
}

enum MoneyCategoryKind {
  INCOME
  EXPENSE
}

enum ObligationType {
  RECURRING // allowance / stipend
  LOAN // principal with a running balance
}

enum ObligationDirection {
  OWED_TO_ME // I lent; they repay me
  OWED_BY_ME // I borrowed; I repay them
}

enum ObligationStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum MoneyEntrySource {
  MANUAL
  IMPORTED
}

enum MoneyEntryMethod {
  CASH
  BANK_TRANSFER
  MOBILE_BANKING
  CHEQUE
  OTHER
}

enum TripStatus {
  PLANNING
  ACTIVE
  CLOSED
}

enum TripCategory {
  FLIGHTS
  ACCOMMODATION
  FOOD
  LOCAL_TRANSPORT
  ACTIVITIES
  SHOPPING
  VISA_INSURANCE
  MISC
}

model MoneyAccount {
  id             String           @id @default(cuid())
  name           String
  type           MoneyAccountType
  currency       String           @default("BDT") // account currency: BDT | USD | EUR. All non-transfer entries are in this currency; balance is in this currency.
  openingBalance Decimal          @default(0) @db.Decimal(12, 2) // real balance at setup, in `currency`; card: negative = owed
  creditLimit    Decimal?         @db.Decimal(12, 2) // CREDIT_CARD only; availableCredit = creditLimit + balance
  isActive       Boolean          @default(true)
  notes          String?
  entries        MoneyEntry[]     @relation("EntryAccount")
  transfersIn    MoneyEntry[]     @relation("EntryTransferAccount")
  tripsAsWallet  Trip[]           @relation("TripWallet")
  tripExpenses   TripExpense[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  // balance = openingBalance + Σ(CREDIT) − Σ(DEBIT, TRANSFER-out) + Σ(TRANSFER-in) — computed in service.
}

model MoneyCategory {
  id        String            @id @default(cuid())
  name      String
  kind      MoneyCategoryKind // source of truth for income/expense bucketing
  isActive  Boolean           @default(true)
  entries   MoneyEntry[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([name, kind])
}

model Beneficiary {
  id                 String                  @id @default(cuid())
  name               String
  relationship       String? // free text: "brother", "house help"
  phone              String?
  isActive           Boolean                 @default(true) // soft-delete; never cascade ledger history
  notes              String?
  entries            MoneyEntry[]
  obligations        BeneficiaryObligation[]
  tripParticipations TripParticipant[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model BeneficiaryObligation {
  id            String              @id @default(cuid())
  beneficiary   Beneficiary         @relation(fields: [beneficiaryId], references: [id])
  beneficiaryId String
  type          ObligationType
  direction     ObligationDirection @default(OWED_BY_ME)
  amount        Decimal             @db.Decimal(12, 2) // recurring: per-period; loan: principal
  frequency     String? // recurring only: "monthly" | "weekly"
  startDate     DateTime
  endDate       DateTime? // null = ongoing
  status        ObligationStatus    @default(ACTIVE)
  notes         String?
  entries       MoneyEntry[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  // loan outstanding = amount − Σ repayment entries (computed in service; may go negative = overpaid)

  @@index([beneficiaryId])
  @@index([status])
}

model MoneyEntry {
  id                String                 @id @default(cuid())
  date              DateTime
  direction         MoneyEntryDirection
  amount            Decimal                @db.Decimal(12, 2) // in the account's currency (source account for TRANSFER)
  currency          String                 @default("BDT") // denormalized snapshot of the account's currency
  // TRANSFER cross-currency: amount leaves the source in `currency`; toAmount arrives at the
  // destination in ITS currency. Same-currency → toAmount == amount. fxRate = BDT per 1 unit of
  // `currency` (for BDT canonicalization in savings/reports). Null treated as 1 / amount defensively.
  toAmount          Decimal?               @db.Decimal(14, 2)
  fxRate            Decimal?               @db.Decimal(18, 6)
  category          MoneyCategory?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId        String? // required for CREDIT/DEBIT (validated in service); null for TRANSFER
  account           MoneyAccount?          @relation("EntryAccount", fields: [accountId], references: [id])
  accountId         String?
  transferAccount   MoneyAccount?          @relation("EntryTransferAccount", fields: [transferAccountId], references: [id])
  transferAccountId String? // destination for TRANSFER entries
  beneficiary       Beneficiary?           @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  beneficiaryId     String?
  obligation        BeneficiaryObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  obligationId      String? // set when this entry pays against a loan/recurring obligation
  // A transfer may charge a fee — booked as a separate EXPENSE DEBIT on the source
  // account and linked back to its TRANSFER here so deleting the transfer removes it.
  feeForTransfer    MoneyEntry?            @relation("TransferFee", fields: [feeForTransferId], references: [id], onDelete: Cascade)
  feeForTransferId  String? // set on the fee entry; points at the parent TRANSFER entry
  transferFees      MoneyEntry[]           @relation("TransferFee")
  description       String?
  notes             String?
  method            MoneyEntryMethod? // how a CREDIT arrived (cash/bank/mobile banking/etc.); null for DEBIT/TRANSFER or unspecified
  source            MoneyEntrySource       @default(MANUAL)
  importBatch       MoneyImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importBatchId     String?
  // Trip Expense Manager: a trip-tagged entry. DEBITs carry a tripCategory (budget
  // bucket); a BDT→local wallet conversion is a tripId-tagged TRANSFER (no category).
  trip              Trip?                  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  tripId            String?
  tripCategory      TripCategory?
  // Trip Expense Manager v2: the group-split expense this ledger entry backs (if any).
  tripExpense       TripExpense?
  // Earnings realized by this (cross-currency TRANSFER) entry — see Earning.transfer.
  realizedEarnings  Earning[]              @relation("EarningRealization")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([date])
  @@index([direction, date])
  @@index([categoryId])
  @@index([accountId])
  @@index([beneficiaryId])
  @@index([obligationId])
  @@index([feeForTransferId])
  @@index([importBatchId])
  @@index([tripId])
}

model MoneyImportBatch {
  id         String       @id @default(cuid())
  fileName   String
  rowCount   Int          @default(0)
  mapping    Json // column → field mapping used (for re-run / rollback)
  importedAt DateTime     @default(now())
  entries    MoneyEntry[]
}

// FX rate cache (base is always BDT). Used to value foreign-currency account
// balances in BDT for the Money dashboard total, and as a daily cache so we
// don't hammer the free FX feed. Per-transaction rates are stored on the row
// (Earning/EmployeePayment/MoneyEntry.fxRate), separate from this current-rate cache.
model FxRate {
  id        String   @id @default(cuid())
  base      String // always "BDT"
  quote     String // "USD" | "EUR"
  rate      Decimal  @db.Decimal(18, 6) // 1 unit of `quote` = `rate` BDT
  asOf      DateTime // when the feed reported it
  fetchedAt DateTime @default(now())
  source    String

  @@unique([base, quote, asOf])
  @@index([base, quote, fetchedAt])
}

// ─── Trip Expense Manager ─────────────────────────────────────────────────────
// A trip is a tag over the money ledger: every trip expense is a normal MoneyEntry
// with tripId set (+ tripCategory = budget bucket). Credit-card vs cash/bank
// behaviour falls out of which account the entry hits. A cross-currency BDT→local
// "trip wallet" conversion is a TRANSFER tagged with tripId (NOT an expense).
// Reports aggregate the tagged entries; balances stay derived from MoneyEntry.
model Trip {
  id                   String            @id @default(cuid())
  name                 String
  destination          String
  homeCurrency         String            @default("BDT") // canonical reporting currency
  localCurrency        String            @default("BDT") // destination currency, e.g. "MYR"
  startDate            DateTime
  endDate              DateTime?
  status               TripStatus        @default(PLANNING)
  // Optional foreign "trip wallet" MoneyAccount (currency = localCurrency), funded
  // by converting from a home account; local cash spend debits it.
  localWalletAccount   MoneyAccount?     @relation("TripWallet", fields: [localWalletAccountId], references: [id], onDelete: SetNull)
  localWalletAccountId String?
  notes                String?
  // Public share: when isPublic, /trips/<publicSlug> renders an aggregate-safe summary.
  publicSlug           String?           @unique
  isPublic             Boolean           @default(false)
  publicIntro          String? // author's tips / summary shown on the shared page
  budgets              TripBudget[]
  entries              MoneyEntry[]
  participants         TripParticipant[]
  expenses             TripExpense[]
  settlements          TripSettlement[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([status])
}

model TripBudget {
  id            String       @id @default(cuid())
  trip          Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId        String
  category      TripCategory
  plannedAmount Decimal      @db.Decimal(12, 2) // BDT-canonical planned budget for this category
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([tripId, category])
  @@index([tripId])
}

// ─── Trip Expense Manager v2 — group trips (participants, splitting, settlements) ─
// A trip gains its own split ledger. TripExpense is the source of truth for every
// shared cost (split into per-participant TripExpenseShare rows). A linked
// MoneyEntry is created ONLY for a self-paid expense from a real spendable account
// (never for credit-card or friend-paid) — see src/services/trips/expenses.ts.
// TripSettlement records money moving between participants (collect fund / settle
// up) and never touches the personal money ledger.

enum TripSplitMode {
  EQUAL
  EXACT
}

model TripParticipant {
  id              String             @id @default(cuid())
  trip            Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId          String
  name            String
  isSelf          Boolean            @default(false) // exactly one per trip = the owner ("Me")
  beneficiary     Beneficiary?       @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  beneficiaryId   String?
  isActive        Boolean            @default(true) // soft-delete; keep split history intact
  note            String?
  paidExpenses    TripExpense[]      @relation("ExpensePayer")
  shares          TripExpenseShare[]
  settlementsFrom TripSettlement[]   @relation("SettlementFrom")
  settlementsTo   TripSettlement[]   @relation("SettlementTo")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([tripId])
  @@index([beneficiaryId])
}

model TripExpense {
  id           String             @id @default(cuid())
  trip         Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId       String
  description  String?
  category     TripCategory
  date         DateTime
  currency     String             @default("BDT") // original expense currency
  amount       Decimal            @db.Decimal(12, 2) // total group cost in `currency`
  fxRate       Decimal?           @db.Decimal(18, 6) // BDT per 1 unit of `currency`
  amountBdt    Decimal            @db.Decimal(14, 2) // amount * fxRate (canonical)
  payer        TripParticipant    @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Cascade)
  payerId      String
  splitMode    TripSplitMode      @default(EQUAL)
  // Funding account for a self-paid expense (incl. the card used, for bucketing).
  account      MoneyAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId    String?
  // Linked ledger entry — set only when the posting rule fires (self + non-card real account).
  moneyEntry   MoneyEntry?        @relation(fields: [moneyEntryId], references: [id], onDelete: SetNull)
  moneyEntryId String?            @unique
  shares       TripExpenseShare[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([tripId])
  @@index([payerId])
  @@index([accountId])
}

model TripExpenseShare {
  id            String          @id @default(cuid())
  expense       TripExpense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId     String
  participant   TripParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String
  amount        Decimal         @db.Decimal(12, 2) // share in the expense currency
  amountBdt     Decimal         @db.Decimal(14, 2) // share in BDT

  @@unique([expenseId, participantId])
  @@index([expenseId])
  @@index([participantId])
}

model TripSettlement {
  id                String          @id @default(cuid())
  trip              Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId            String
  date              DateTime
  from              TripParticipant @relation("SettlementFrom", fields: [fromParticipantId], references: [id], onDelete: Cascade)
  fromParticipantId String
  to                TripParticipant @relation("SettlementTo", fields: [toParticipantId], references: [id], onDelete: Cascade)
  toParticipantId   String
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("BDT")
  fxRate            Decimal?        @db.Decimal(18, 6)
  amountBdt         Decimal         @db.Decimal(14, 2)
  note              String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tripId])
}

// ─── Public consultation bookings ─────────────────────────────────────────────

// Admin-editable booking config (singleton). workingHours is an array of
// `{ weekday, start, end }` where weekday is 0=Sun..6=Sat and start/end are
// "HH:MM" local-time strings; multiple ranges per weekday are allowed.
// googleToken* mirror the BackupSettings pattern — AES-256-GCM, AI_CONFIG_SECRET.
model BookingSettings {
  id                   String   @id @default("singleton")
  enabled              Boolean  @default(false)
  calendarId           String   @default("primary")
  meetingTitleTemplate String   @default("Consultation — {name}")
  meetingDescription   String?  @db.Text
  durationsMinutes     Int[]    @default([30])
  slotIncrementMinutes Int      @default(15)
  bufferMinutes        Int      @default(15)
  minNoticeHours       Int      @default(24)
  maxHorizonDays       Int      @default(14)
  timezone             String   @default("Asia/Dhaka")
  workingHours         Json
  notifyEmail          String? // optional extra invitee on every booking
  whatsappNumber       String? // E.164 digits (no +), for wa.me link
  whatsappPrefill      String?
  whatsappEnabled      Boolean  @default(true)
  // Google OAuth (Calendar scope) — refresh token at rest, encrypted.
  googleConnected      Boolean  @default(false)
  googleEmail          String?
  googleTokenEnc       String?  @db.Text
  googleTokenIv        String?
  googleTokenTag       String?
  updatedAt            DateTime @updatedAt
}

// Date-resolution closures (holidays, vacation). One row per blacked-out day.
model BookingBlackout {
  id        String   @id @default(cuid())
  date      DateTime // midnight local on the blacked-out day
  reason    String?
  createdAt DateTime @default(now())

  @@unique([date])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// One row per visitor booking. cancelToken backs the visitor's self-cancel link.
// ip is only kept for rate-limit lookups (per-IP create caps).
model Booking {
  id            String        @id @default(cuid())
  name          String
  email         String
  topic         String
  message       String?       @db.Text
  startsAt      DateTime
  endsAt        DateTime
  durationMin   Int
  status        BookingStatus @default(CONFIRMED)
  googleEventId String?
  meetUrl       String?
  cancelToken   String        @unique
  ip            String?
  cancelledAt   DateTime?
  cancelReason  String?       @db.Text
  createdAt     DateTime      @default(now())

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([ip, createdAt])
}

// ─── Solar Monitoring (SolisCloud) ──────────────────────────────────────────
// Read-only solar telemetry pulled from SolisCloud on a schedule into
// SolisDailyReading. We NEVER write to / control the inverter via the API —
// only read endpoints are implemented. Electricity cost is computed from
// effective-dated BPDB slab tariffs (ElectricityTariff + TariffSlab). API
// credentials live in env (SOLIS_KEY_ID / SOLIS_KEY_SECRET / SOLIS_API_URL),
// never in the DB.

// System configuration singleton. Holds non-secret config: capacity, battery
// size, install cost (for the payback tracker), location (for weather), and the
// last-sync status. stationId is auto-discovered from the API on first sync.
model SolarSettings {
  id                String    @id @default("singleton")
  systemSizeKwp     Decimal?  @db.Decimal(8, 2) // array DC capacity; auto-filled from API if null
  batteryKwh        Decimal?  @db.Decimal(8, 2) // storage capacity (e.g. 16)
  installCost       Decimal   @default(0) @db.Decimal(12, 2) // BDT — total system cost (e.g. 580000)
  installDate       DateTime? // commissioning date; backfill + payback start here
  currency          String    @default("BDT")
  co2FactorKgPerKwh Decimal   @default(0.6495) @db.Decimal(8, 4) // grid emission factor (kg CO2 / kWh)
  latitude          Float? // plant location — used for the weather forecast
  longitude         Float?
  stationId         String? // SolisCloud plant id (auto-discovered on first sync)
  lastSyncAt        DateTime?
  lastSyncStatus    String? // "ok" | "error"
  lastSyncError     String?   @db.Text
  updatedAt         DateTime  @updatedAt
}

// Effective-dated electricity tariff version (mirrors the SubscriptionRateChange
// pattern). The tariff in force for a given month is the one with the latest
// effectiveFrom <= that month. Each version owns its slab table, demand charge,
// and VAT — so a government revision is just a new row + slabs.
model ElectricityTariff {
  id                String       @id @default(cuid())
  name              String // e.g. "BPDB Residential — pre-June 2026"
  distributor       String       @default("BPDB")
  effectiveFrom     DateTime // normalized to the 1st of the month it takes effect
  demandChargePerKw Decimal      @default(0) @db.Decimal(10, 2) // BDT per sanctioned kW
  vatPercent        Decimal      @default(5) @db.Decimal(5, 2) // % applied to (energy + demand)
  note              String?
  slabs             TariffSlab[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([effectiveFrom])
}

// One consumption band of a tariff. Slabs are cumulative over the billing month:
// the month's total units fall through fromUnit..toUnit. The top slab has a null
// toUnit (unbounded). rate is BDT per kWh.
model TariffSlab {
  id        String            @id @default(cuid())
  tariff    ElectricityTariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)
  tariffId  String
  fromUnit  Int // inclusive lower bound in kWh (e.g. 0, 51, 76)
  toUnit    Int? // inclusive upper bound; null = unbounded top slab
  rate      Decimal           @db.Decimal(10, 4) // BDT per kWh
  createdAt DateTime          @default(now())

  @@index([tariffId])
}

// One row per day per inverter — the local snapshot of SolisCloud daily energy
// flows. Reports aggregate over these, so they're instant and survive API
// downtime / rate limits. `raw` keeps the original payload for audit/repair.
model SolisDailyReading {
  id                  String   @id @default(cuid())
  date                DateTime // midnight local of the reading day
  inverterSn          String // inverter serial number
  generationKwh       Decimal  @default(0) @db.Decimal(10, 3) // PV produced
  gridImportKwh       Decimal  @default(0) @db.Decimal(10, 3) // bought from grid
  gridExportKwh       Decimal  @default(0) @db.Decimal(10, 3) // sold to grid (~0 today)
  batteryChargeKwh    Decimal  @default(0) @db.Decimal(10, 3)
  batteryDischargeKwh Decimal  @default(0) @db.Decimal(10, 3)
  consumptionKwh      Decimal  @default(0) @db.Decimal(10, 3) // household load
  peakPowerKw         Decimal  @default(0) @db.Decimal(10, 3) // highest instantaneous AC power
  batterySocMin       Decimal? @db.Decimal(5, 2) // % at day's lowest
  batterySocMax       Decimal? @db.Decimal(5, 2) // % at day's highest
  inverterTempC       Decimal? @db.Decimal(6, 2)
  raw                 Json? // original API payload (audit / re-derivation)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([inverterSn, date])
  @@index([date])
}
