// Prisma schema for sshakil.com
// Stack: PostgreSQL, NextAuth v5, App Router

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth) ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // bcrypt hash — null for future OAuth users
  role          Role      @default(ADMIN)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  VIEWER
}

// ─── Portfolio Settings (admin-editable) ─────────────────────────────────────

model SiteSettings {
  id                String   @id @default("singleton")
  availableForWork  Boolean  @default(true)
  heroTagline       String   @default("Tech Lead & Full-Stack Engineer")
  heroBio           String   @db.Text
  metaDescription   String   @db.Text
  metaKeywords      String   @db.Text
  cvUrl             String   @default("https://drive.google.com/file/d/15jSzTm3iaj_ghVqgC_t1Wk9bKnsIfGIA/view?usp=sharing")
  updatedAt         DateTime @updatedAt
}

// ─── Property Settings (singleton) ───────────────────────────────────────────

model PropertySettings {
  id           String   @id @default("singleton")
  propertyName String   @default("Shakil Property")
  ownerName    String   @default("Md. Syful Islam Shakil")
  ownerPhone   String   @default("")
  address      String   @default("Dhaka, Bangladesh")
  bankAccount  String?
  updatedAt    DateTime @updatedAt
}

// ─── Property Management ──────────────────────────────────────────────────────

model Unit {
  id          String    @id @default(cuid())
  unitNumber  String    @unique   // e.g. "Flat 1A", "Flat 2B"
  floor       String              // e.g. "Ground Floor", "1st Floor"
  monthlyRent Decimal   @db.Decimal(10, 2)
  description String?
  isOccupied  Boolean   @default(false)
  notes       String?
  tenants     Tenant[]
  payments    Payment[]
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum TenantStatus {
  CURRENT
  FUTURE
  PAST
}

model Tenant {
  id             String          @id @default(cuid())
  tenantCode     String?         @unique   // e.g. "T01", "T02"
  name           String
  phone          String?
  email          String?
  nidNumber      String?
  isExternal     Boolean         @default(false)  // true = parking-only / non-resident member
  moveInDate     DateTime
  moveOutDate    DateTime?
  leaseEndDate   DateTime?
  isActive       Boolean         @default(true)
  tenantStatus   TenantStatus    @default(CURRENT)  // CURRENT | FUTURE | PAST
  advancePaid    Boolean         @default(false)
  advanceAmount  Decimal?        @db.Decimal(10, 2)  // BDT held; decreases as advance is applied
  advanceSettled Boolean         @default(false)
  notes          String?
  unit           Unit?           @relation(fields: [unitId], references: [id])
  unitId         String?         // no @unique — multiple tenants (current + future) share a unit
  payments       Payment[]
  services       TenantService[]
  rentChanges    RentChange[]
  documents      TenantDocument[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Payment {
  id              String               @id @default(cuid())
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  tenantId        String
  unit            Unit?                @relation(fields: [unitId], references: [id])
  unitId          String?              // null for external members
  rentDue         Decimal              @db.Decimal(10, 2)   // expected total (rent + services + carry-forward)
  amountPaid      Decimal              @default(0) @db.Decimal(10, 2)  // cash/bank received
  advanceApplied  Decimal              @default(0) @db.Decimal(10, 2)  // drawn from tenant advance
  carryForward    Decimal              @default(0) @db.Decimal(10, 2)  // unpaid balance carried from previous month
  month           Int                  // 1–12
  year            Int
  paidDate        DateTime?            // date of most recent payment transaction
  status          PaymentStatus        @default(PENDING)
  receiptNumber   String?              @unique  // e.g. "RCP-2026-0001"
  notes           String?
  transactions    PaymentTransaction[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([tenantId, month, year])
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

model PaymentTransaction {
  id        String          @id @default(cuid())
  payment   Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String
  type      TransactionType
  amount    Decimal         @db.Decimal(10, 2)
  date      DateTime
  notes     String?
  createdAt DateTime        @default(now())
}

enum TransactionType {
  CASH
  BANK_TRANSFER
  ADVANCE_APPLIED
  ADJUSTMENT
  OTHER
}

model AddOnService {
  id          String          @id @default(cuid())
  name        String          @unique  // e.g. "WiFi", "Parking", "Generator"
  description String?
  isActive    Boolean         @default(true)
  tenants     TenantService[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TenantService {
  id         String       @id @default(cuid())
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  tenantId   String
  service    AddOnService @relation(fields: [serviceId], references: [id])
  serviceId  String
  monthlyFee Decimal      @db.Decimal(10, 2)  // per-tenant rate (variable)
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean      @default(true)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([tenantId, serviceId])
}

model RentChange {
  id            String    @id @default(cuid())
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  tenantId      String
  effectiveDate DateTime
  previousRent  Decimal   @db.Decimal(10, 2)
  newRent       Decimal   @db.Decimal(10, 2)
  reason        String?
  appliedAt     DateTime?  // null = pending; set when payment generation picks it up
  createdAt     DateTime  @default(now())
}

// ─── Tenant Documents ─────────────────────────────────────────────────────────

model TenantDocument {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  fileName   String   // original filename shown to user
  storedName String   // unique name on disk (avoids collisions)
  mimeType   String
  size       Int      // bytes
  label      String?  // optional label e.g. "NID Front", "Contract"
  uploadedAt DateTime @default(now())
}

// ─── Income & Expenses ────────────────────────────────────────────────────────

model Income {
  id          String      @id @default(cuid())
  source      String      // e.g. "Savannah Group", "Christoph - AI Project"
  amount      Decimal     @db.Decimal(10, 2)
  currency    String      @default("BDT")
  month       Int
  year        Int
  category    IncomeCategory
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum IncomeCategory {
  SALARY
  FREELANCE
  RENTAL
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  description String
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("BDT")
  category    ExpenseCategory
  month       Int
  year        Int
  expenseDate DateTime?
  paidTo      String?
  paymentMode String?
  unitId      String?
  unit        Unit?           @relation(fields: [unitId], references: [id])
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum ExpenseCategory {
  MAINTENANCE
  UTILITY
  SALARY         // employee
  SUBSCRIPTION
  CONSTRUCTION
  OTHER
}

// ─── Renovation Tracker ───────────────────────────────────────────────────────

model RenovationItem {
  id          String            @id @default(cuid())
  title       String
  category    String            // e.g. "Materials", "Constructor", "Services"
  subCategory String?
  amount      Decimal           @db.Decimal(10, 2)
  vendor      String?
  date        DateTime?
  status      RenovationStatus  @default(PLANNED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum RenovationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
